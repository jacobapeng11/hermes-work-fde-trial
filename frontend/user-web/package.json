{
  "name": "@hermes-cloud/user-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public-prod": "python3 ../../scripts/test-user-web-public-prod.py",
    "test:e2e:dev-backend": "playwright test --config=playwright.dev-backend.config.ts",
    "test:e2e:dev": "PLAYWRIGHT_USE_DEV_SERVER=1 playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:contracts": "bash ../../scripts/check-user-web-contracts.sh",
    "smoke": "bash ../../scripts/smoke-user-web.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@hermes-cloud/schemas": "file:../../packages/schemas",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.29.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
