# Copy to backend/.env and replace every example value before production use.
APP_ENV=production
BACKEND_HOST=127.0.0.1
BACKEND_LOCAL_HOST=127.0.0.1
BACKEND_PORT=8011
PORT_BACKEND=8011
USER_WEB_HOST=127.0.0.1
USER_WEB_PORT=15175
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=15174
RUNTIME_CHAT_MODE=real
PUBLIC_WEB_BASE=https://app.example.com
PUBLIC_ADMIN_BASE=https://app.example.com/admin
PUBLIC_API_BASE=https://app.example.com
PUBLIC_RELEASE_ROOT=/opt/hermes/current
PUBLIC_NGINX_CONFIG=/etc/nginx/conf.d/hermes-work.conf
PUBLIC_NGINX_DEV_CONFIG=
PUBLIC_NGINX_LISTEN_HOST=127.0.0.1
PUBLIC_NGINX_API_LISTEN_HOST=127.0.0.1
PUBLIC_NGINX_WEB_LISTEN_PORT=8080
PUBLIC_NGINX_API_LISTEN_PORT=8080
CORS_ORIGINS=https://app.example.com

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hermes
MYSQL_PASSWORD=REPLACE_WITH_DB_PASSWORD
MYSQL_DB=hermes_cloud
MYSQL_SSL_MODE=REQUIRED
REDIS_URL=redis://127.0.0.1:6379/0

HERMES_AUTH_MODE=oauth2
HERMES_ADMIN_AUTH_MODE=inherit
DEFAULT_ORG_ID=1
COMPANY_DIRECTORY_NAMES='{"1":"示例公司"}'
OAUTH2_PROVIDER_ID=customer-idp
OAUTH2_CLIENT_ID=REPLACE_WITH_CLIENT_ID
OAUTH2_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
OAUTH2_AUTHORIZATION_URL=https://idp.example.com/oauth2/authorize
OAUTH2_TOKEN_URL=https://idp.example.com/oauth2/token
OAUTH2_USERINFO_URL=https://idp.example.com/oauth2/userinfo
OAUTH2_REDIRECT_URI=https://app.example.com/api/v1/auth/oauth2/callback
OAUTH2_USER_ID_FIELD=sub
OAUTH2_USER_WORK_NO_FIELD=employee_id
OAUTH2_USER_NAME_FIELD=name
OAUTH2_USER_EMAIL_FIELD=email
OAUTH2_SCOPES='openid profile email'
OAUTH2_PKCE_ENABLED=true
OAUTH2_CONFIG_REVISION=1

JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_BYTES
AES_ENCRYPTION_KEY=REPLACE_WITH_MANAGED_KEY
RUNTIME_TOKEN_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
FILE_DOWNLOAD_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_INITIAL_WORK_NOS=REPLACE_WITH_ADMIN_WORK_NO

HERMES_RUNTIME_NAMESPACE=hermes-runtimes
HERMES_RUNTIME_NODE_NAME=REPLACE_WITH_K8S_NODE_NAME
HERMES_RUNTIME_IMAGE=registry.example.com/hermes/runtime:trial
HERMES_RUNTIME_IMAGE_MANIFEST_DIGEST=REPLACE_WITH_SHA256_DIGEST
HERMES_RUNTIME_IMAGE_CONFIG_ID=REPLACE_WITH_SHA256_CONFIG_ID
HERMES_RUNTIME_ROOT=/data/hermes/runtimes
HERMES_RUNTIME_STORAGE_TARGET=/data/hermes
HERMES_RUNTIME_STORAGE_SOURCE=REPLACE_WITH_FINDMNT_SOURCE
HERMES_RUNTIME_STORAGE_UUID=REPLACE_WITH_FILESYSTEM_UUID
HERMES_RUNTIME_STORAGE_FSTYPE=REPLACE_WITH_FILESYSTEM_TYPE
HERMES_RUNTIME_INGRESS_BASE_URL=http://127.0.0.1:30364
KUBECONFIG=/etc/hermes/kubeconfig
ADMIN_KUBECONFIG=/etc/hermes/kubeconfig

# Optional integrations; leave empty until the customer provisions them.
KNOWLEDGE_DATA_SERVICE_BASE_URL=
ENTERPRISE_KNOWLEDGE_HOST_PATH=
PERSONAL_KNOWLEDGE_OSS_UPLOAD_URL=
PERSONAL_KNOWLEDGE_OSS_PUBLIC_BASE_URL=
PERSONAL_KNOWLEDGE_OSS_INTERNAL_HOST=
AVATAR_OSS_UPLOAD_URL=
AVATAR_OSS_PUBLIC_BASE_URL=
AVATAR_OSS_INTERNAL_HOST=
