# Example static-release configuration. The external TLS gateway terminates HTTPS
# and forwards the configured domain to 127.0.0.1:8080. This file serves
# the static bundles published in PUBLIC_RELEASE_ROOT.
server {
    listen 127.0.0.1:8080 default_server;
    server_name app.example.com;

    root /opt/hermes/current/frontend/user-web/dist;

    # One-time desktop app launch tickets must not be retained in access logs.
    location = /api/v1/user/data-app-launch/redeem {
        access_log off;
        proxy_pass http://127.0.0.1:8011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin https://app.example.com;
        proxy_buffering off;
        proxy_cache off;
    }

    location = /api/v1/auth/oauth2/callback {
        # OAuth2 request URIs must not enter access or upstream-error logs.
        access_log off;
        error_log /dev/null;
        client_max_body_size 50m;
        proxy_pass http://127.0.0.1:8011;
        proxy_http_version 1.1;
        # Stream API uploads; do not spill request bodies into a worker-owned temp path.
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # the external TLS gateway may omit Origin on the internal hop. This is only for the
        # browser-facing listener; the Runtime listener below preserves none.
        proxy_set_header Origin https://app.example.com;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        tcp_nodelay on;
        proxy_read_timeout 4000s;
        proxy_send_timeout 4000s;
    }

    location = /api/v1/auth/oauth2/login {
        # OAuth2 request URIs must not enter access or upstream-error logs.
        access_log off;
        error_log /dev/null;
        client_max_body_size 50m;
        proxy_pass http://127.0.0.1:8011;
        proxy_http_version 1.1;
        # Stream API uploads; do not spill request bodies into a worker-owned temp path.
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # the external TLS gateway may omit Origin on the internal hop. This is only for the
        # browser-facing listener; the Runtime listener below preserves none.
        proxy_set_header Origin https://app.example.com;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        tcp_nodelay on;
        proxy_read_timeout 4000s;
        proxy_send_timeout 4000s;
    }

    location = /api/v1/auth/oauth2/complete {
        # OAuth2 request URIs must not enter access or upstream-error logs.
        access_log off;
        error_log /dev/null;
        client_max_body_size 50m;
        proxy_pass http://127.0.0.1:8011;
        proxy_http_version 1.1;
        # Stream API uploads; do not spill request bodies into a worker-owned temp path.
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # the external TLS gateway may omit Origin on the internal hop. This is only for the
        # browser-facing listener; the Runtime listener below preserves none.
        proxy_set_header Origin https://app.example.com;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        tcp_nodelay on;
        proxy_read_timeout 4000s;
        proxy_send_timeout 4000s;
    }

    location ^~ /api/v1/ {
        client_max_body_size 101m;
        proxy_pass http://127.0.0.1:8011;
        proxy_http_version 1.1;
        # Stream API uploads; do not spill request bodies into a worker-owned temp path.
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # the external TLS gateway may omit Origin on the internal hop. This is only for the
        # browser-facing listener; the Runtime listener below preserves none.
        proxy_set_header Origin https://app.example.com;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        tcp_nodelay on;
        proxy_read_timeout 4000s;
        proxy_send_timeout 4000s;
    }

    location ^~ /openapi/v1/ {
        client_max_body_size 50m;
        proxy_pass http://127.0.0.1:8011;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        tcp_nodelay on;
        proxy_read_timeout 4000s;
        proxy_send_timeout 4000s;
    }

    location ~ "^/runtime-edge/(?<runtime_handle>[a-z0-9](?:[-a-z0-9.]{0,126}[a-z0-9])?)/ws$" {
        access_log off;
        set $runtime_edge_auth_handle $runtime_handle;
        auth_request /_runtime-edge-auth;
        auth_request_set $runtime_upstream_host $upstream_http_x_hermes_runtime_host;

        rewrite ^ /runtime-edge break;
        proxy_pass http://127.0.0.1:30364;
        proxy_http_version 1.1;
        proxy_set_header Host $runtime_upstream_host;
        proxy_set_header Origin https://app.example.com;
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 4000s;
        proxy_send_timeout 4000s;
    }

    location ~ "^/runtime-files/(?<runtime_file_handle>[a-z0-9](?:[-a-z0-9.]{0,126}[a-z0-9])?)/(?<runtime_file_operation>upload|download)$" {
        access_log off;
        client_max_body_size 100m;
        set $runtime_file_auth_handle_saved $runtime_file_handle;
        set $runtime_file_auth_operation_saved $runtime_file_operation;
        auth_request /_runtime-file-auth;
        auth_request_set $runtime_file_upstream_host $upstream_http_x_hermes_runtime_host;

        rewrite ^/runtime-files/[a-z0-9][-a-z0-9.]*/(upload|download)$ /runtime-files/$1 break;
        proxy_pass http://127.0.0.1:30364;
        proxy_http_version 1.1;
        proxy_set_header Host $runtime_file_upstream_host;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 4000s;
        proxy_send_timeout 4000s;
    }

    location = /_runtime-file-auth {
        internal;
        access_log off;
        client_max_body_size 100m;
        proxy_pass http://127.0.0.1:8011/internal/v1/runtime-file-auth/$runtime_file_auth_handle_saved;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Hermes-File-Operation $runtime_file_auth_operation_saved;
    }

    location = /_runtime-edge-auth {
        internal;
        access_log off;
        proxy_pass http://127.0.0.1:8011/internal/v1/runtime-edge-auth/$runtime_edge_auth_handle;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Origin https://app.example.com;
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
    }

    location = /admin {
        return 301 /admin/;
    }

    location ^~ /admin/ {
        alias /opt/hermes/current/frontend/admin-web/dist/;
        try_files $uri $uri/ /admin/index.html;
    }

    # Keep callback query parameters out of access logs.
    location = / {
        access_log off;
        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
